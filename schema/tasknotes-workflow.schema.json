{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://tasknotes.dev/schemas/legacy/tasknotes-workflow.schema.json",
	"title": "Legacy TaskNotes Workflow Input",
	"$comment": "TaskNotes workflow authoring schema. Contract events and externally provided actions use the mdbase interoperability profile.",
	"type": "object",
	"additionalProperties": true,
	"required": ["type", "schemaVersion", "id", "name", "enabled", "triggers", "steps", "run"],
	"properties": {
		"type": { "enum": ["workflow", "tasknotes-workflow"] },
		"schemaVersion": { "const": 1 },
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9._-]*$"
		},
		"name": { "type": "string", "minLength": 1 },
		"description": { "type": "string" },
		"enabled": { "type": "boolean" },
		"requires": { "$ref": "#/$defs/requires" },
		"vars": {
			"type": "object",
			"additionalProperties": true
		},
		"triggers": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/trigger" }
		},
		"conditions": {
			"type": "array",
			"items": { "$ref": "#/$defs/condition" }
		},
		"steps": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/step" }
		},
		"run": { "$ref": "#/$defs/runPolicy" },
		"debug": {
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"logToVault": { "type": "boolean" },
				"folder": { "type": "string" },
				"console": { "type": "boolean" }
			}
		}
	},
	"$defs": {
		"requires": {
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"capabilities": {
					"type": "array",
					"items": { "type": "string" }
				},
				"providers": {
					"type": "array",
					"items": {
						"oneOf": [
							{ "type": "string", "minLength": 1 },
							{
								"type": "object",
								"required": ["id"],
								"additionalProperties": false,
								"properties": {
									"id": { "type": "string", "minLength": 1 },
									"version": { "type": "string", "minLength": 1 }
								}
							}
						]
					}
				}
			}
		},
		"trigger": {
			"type": "object",
			"required": ["id", "type"],
			"additionalProperties": true,
			"properties": {
				"id": { "type": "string" },
				"type": {
					"enum": [
						"tasknotes.event",
						"task.event",
						"runtime.event",
						"contract.event",
						"cron",
						"interval",
						"manual",
						"obsidian.vault",
						"obsidian.metadata",
						"obsidian.workspace"
					]
				},
				"event": { "type": "string" },
				"contract": { "type": "string" },
				"version": { "type": "string" },
				"source": { "type": "string" },
				"provider": {},
				"schedule": { "type": "string" },
				"every": { "type": "string" },
				"timezone": { "type": "string" },
				"from": {},
				"to": {},
				"path": { "$ref": "#/$defs/pathFilter" },
				"debounce": { "type": "string" },
				"minimumInterval": { "type": "string" },
				"allowSelfTrigger": { "type": "boolean" },
				"catchUp": { "type": "boolean" },
				"data": {}
			}
		},
		"pathFilter": {
			"type": "object",
			"additionalProperties": true,
			"properties": {
				"glob": { "type": "string" },
				"extension": { "type": "string" }
			}
		},
		"condition": {
			"oneOf": [
				{ "$ref": "#/$defs/expression" },
				{ "$ref": "#/$defs/fieldCondition" }
			]
		},
		"fieldCondition": {
			"type": "object",
			"required": ["field", "operator"],
			"additionalProperties": true,
			"properties": {
				"id": { "type": "string" },
				"field": { "type": "string" },
				"operator": {
					"enum": [
						"is",
						"isNot",
						"in",
						"notIn",
						"exists",
						"missing",
						"contains",
						"startsWith",
						"endsWith",
						"before",
						"after",
						"onOrBefore",
						"onOrAfter"
					]
				},
				"value": {}
			}
		},
		"step": {
			"type": "object",
			"required": ["id", "type"],
			"additionalProperties": true,
			"properties": {
				"id": { "type": "string" },
				"type": { "type": "string" },
				"name": { "type": "string" },
				"input": {
					"type": "object",
					"additionalProperties": true
				},
				"if": {
					"oneOf": [
						{ "$ref": "#/$defs/condition" },
						{ "type": "array", "items": { "$ref": "#/$defs/condition" } }
					]
				},
				"forEach": {
					"oneOf": [
						{ "$ref": "#/$defs/forEach" },
						{ "type": "string" },
						{ "$ref": "#/$defs/expression" }
					]
				},
				"requires": { "$ref": "#/$defs/requires" },
				"contract": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"version": { "type": "string", "minLength": 1 },
						"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
					}
				},
				"provider": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"application": { "type": "string", "minLength": 1 },
						"implementation": { "type": "string", "minLength": 1 },
						"instance_id": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		"forEach": {
			"type": "object",
			"required": ["items"],
			"additionalProperties": true,
			"properties": {
				"items": {},
				"as": {
					"type": "string",
					"pattern": "^[A-Za-z][A-Za-z0-9_]*$"
				}
			}
		},
		"expression": {
			"type": "object",
			"required": ["$expr"],
			"additionalProperties": true,
			"properties": {
				"$expr": { "type": "string", "minLength": 1 }
			}
		},
		"runPolicy": {
			"type": "object",
			"required": ["mode", "source", "onError"],
			"additionalProperties": true,
			"properties": {
				"mode": { "const": "sequential" },
				"concurrency": {
					"type": "object",
					"additionalProperties": true,
					"properties": {
						"group": { "type": "string" },
						"policy": { "enum": ["skip", "queue", "replace", "allow"] }
					}
				},
				"limits": {
					"type": "object",
					"additionalProperties": true,
					"properties": {
						"maxItems": { "type": "number", "exclusiveMinimum": 0 },
						"timeout": { "type": "string" }
					}
				},
				"source": { "type": "string" },
				"onError": { "enum": ["stop", "continue"] },
				"noOverlap": { "type": "boolean" },
				"maxTasks": { "type": "number" },
				"timeout": { "type": "string" }
			}
		}
	}
}
